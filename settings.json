const net = require("net");

const socket = new net.Socket();

socket.setTimeout(5000);

socket.connect(55797, "dittosieuto.play.hosting", () => {
    console.log("[TEST] Minecraft TCP port OPEN");
    socket.destroy();
});

socket.on("error", err => {
    console.log("[TEST] Minecraft TCP:", err.code);
});

socket.on("timeout", () => {
    console.log("[TEST] Minecraft TCP: TIMEOUT");
    socket.destroy();
});
